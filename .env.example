# pela-discord-bot -- environment reference (design-part4 SI)
# Copy to `.env` and fill in the blank values. `.env` is never committed.

# --- Required at boot -------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# --- Conditionally required --------------------------------------------------
# Required only once the Spotify provider is registered (Phase 5); validated
# at provider construction, not at boot before then (C-15).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Required (and existence-checked) only when POT_PROVIDER_MODE=managed (C-28).
POT_PROVIDER_PATH=vendor/bgutil-pot-provider/build/main.js

# Never required -- unset simply disables GET /health/detail.
HEALTH_DETAIL_TOKEN=

# --- Runtime / networking -----------------------------------------------------
NODE_ENV=production

# PORT must ship BLANK. The resolution chain is
# SERVER_PORT -> SERVER_ALLOCATION_PORT -> PORT -> 3000 (default).
# A filled-in PORT here would make a hosting panel's own SERVER_PORT
# unreachable and break the health endpoint after deploy (D-15).
PORT=

# Panel-supplied; left unset by default so the panel's own values win the
# resolution chain above. Uncomment and set only for local overrides.
SERVER_PORT=
SERVER_ALLOCATION_PORT=

SERVER_IP=0.0.0.0
LOG_LEVEL=info

# --- Queue / playlist limits ---------------------------------------------------
MAX_PLAYLIST_SIZE=500
MAX_QUEUE_SIZE=1000
MAX_SEARCH_RESULTS=5
QUEUE_PAGE_SIZE=10

# --- Voice ---------------------------------------------------------------------
VOICE_IDLE_TIMEOUT_MS=300000
VOICE_JOIN_TIMEOUT_MS=20000
VOICE_RECONNECT_ATTEMPTS=5

# --- Prefetch --------------------------------------------------------------------
PREFETCH_TRACKS=1

# --- Timeouts and SLOs -------------------------------------------------------------
SEARCH_TIMEOUT_MS=8000
RESOLVE_TIMEOUT_MS=10000
STREAM_OPEN_TIMEOUT_MS=10000
PLAY_START_TIMEOUT_MS=5000
TRACK_START_DEADLINE_MS=15000
TRACK_START_SLO_MS=5000
SLOW_START_THRESHOLD=5

# --- Failure thresholds --------------------------------------------------------------
PLAYBACK_START_THRESHOLD=3
TOOL_FAILURE_THRESHOLD=5

# --- Rate limiting -----------------------------------------------------------------
RATE_LIMIT_PLAY_MAX=5
RATE_LIMIT_PLAY_WINDOW_MS=10000

# --- Matching --------------------------------------------------------------------
MATCH_LOW_CONFIDENCE_THRESHOLD=0.35

# --- Audio provider chain and circuits -------------------------------------------------
AUDIO_PROVIDER_CHAIN=ytdlp
AUDIO_FAILURE_THRESHOLD=3
AUDIO_FAILURE_WINDOW_MS=120000
AUDIO_DEGRADED_COOLDOWN_MS=300000

# Informational only -- the 2a item 11 pass condition; not read by the bot.
MEMORY_BUDGET_MB=700

# --- yt-dlp / FFmpeg ---------------------------------------------------------------
# Leave blank to use the bundled bin/yt-dlp[.exe] next to the app, falling
# back to a bare `yt-dlp` on PATH (C-19).
YTDLP_PATH=
YTDLP_ARGS_EXTRA=
FFMPEG_PATH=ffmpeg

# --- PO Token provider ----------------------------------------------------------------
POT_PROVIDER_MODE=managed
POT_PROVIDER_URL=http://127.0.0.1:4416
POT_SUPERVISOR_REARM_MS=1800000
POT_PING_FAILURES=3

# --- YouTube cookies (optional) -------------------------------------------------------
YOUTUBE_COOKIES_PATH=
